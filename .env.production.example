# Copy this file to .env.production and fill in real values.
# .env.production is gitignored - never commit real secrets.

# Supabase pooled connection (port 6543) - used by the running app for all
# normal queries. Get this from Supabase dashboard > Project Settings >
# Database > Connection string > "Transaction pooler".
DATABASE_URL="postgresql://<user>:<password>@<project-ref>.pooler.supabase.com:6543/postgres"

# Supabase SESSION pooler (port 5432, through the pooler host) - used only
# by the entrypoint's `prisma migrate deploy`, which needs a non-pooled-style
# connection (one persistent session, for its advisory lock).
#
# Do NOT use Supabase's raw "Direct connection" (db.<project-ref>.supabase.co)
# here: that host is IPv6-only, and Docker Desktop's containers only have
# outbound IPv4 - migrations will hang indefinitely trying to reach it.
# The Session pooler gives direct-connection semantics while staying
# IPv4-reachable, since it resolves through the same pooler infrastructure as
# DATABASE_URL above. Get this from Supabase dashboard > Project Settings >
# Database > Connection string > "Session pooler".
DIRECT_URL="postgresql://<user>:<password>@<project-ref>.pooler.supabase.com:5432/postgres"

# Supabase's pooler needs relaxed SSL verification; tells prisma.service.ts
# to enable it.
DATABASE_SSL="true"

# Tells prisma.config.ts to run migrations against DIRECT_URL (Supabase)
# instead of the local-dev default.
MIGRATE_TARGET="supabase"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-real-random-secret"
JWT_EXPIRES_IN="15m"

PORT="3000"
