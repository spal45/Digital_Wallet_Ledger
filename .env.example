# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# Local Postgres connection, used by the running app in local development.
DATABASE_URL="postgresql://postgres@localhost:5432/digital_wallet?schema=public"

# Same as DATABASE_URL by default; only needed to differ if you're pointing
# migrations at a different database than the running app locally.
LOCAL_DATABASE_URL="postgresql://postgres@localhost:5432/digital_wallet?schema=public"

# Leave unset/false for local or Docker Compose Postgres (no SSL support).
# Set to "true" only when DATABASE_URL points at a provider that requires it
# (e.g. Supabase's pooler) - see src/prisma/prisma.service.ts.
DATABASE_SSL="false"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-real-random-secret"
JWT_EXPIRES_IN="15m"

PORT="3000"
